{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md"],
      "options": { "proseWrap": "always", "printWidth": 80 }
    },
    {
      "files": ["*.{json,yml,yaml}"],
      "options": { "tabWidth": 2 }
    }
  ]
}
